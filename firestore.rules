rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isRegistered() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{uid} {
      // Admins can read any user doc so the /admin/codes page can resolve
      // a code's claimer to an email address. Writes are still restricted to
      // the owner.
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Admin role is just a presence-check on this collection. Bootstrap the
    // first admin doc with the Admin SDK (scripts/grant-admin.js) — no
    // self-promotion is allowed.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isRegistered();
    }

    match /links/{linkId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isRegistered();
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && isRegistered();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && isRegistered();
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Invite codes:
    //   - Anyone can `get` a single code (so /register can verify a code).
    //   - Only admins can `list` the collection (no enumeration by buyers).
    //   - Only admins can `create` new codes (the admin UI / scripts use this).
    //   - Any signed-in user can `update` to claim an unclaimed code by
    //     setting claimedBy = their own uid + claimedAt; nothing else can
    //     change.
    //   - Only admins can `delete`, and only on still-unclaimed codes.
    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && (!("claimedBy" in request.resource.data)
            || request.resource.data.claimedBy == null);
      allow update: if request.auth != null
        && (!("claimedBy" in resource.data) || resource.data.claimedBy == null)
        && request.resource.data.claimedBy == request.auth.uid
        // claimedEmail is optional, but if set it must match the caller's
        // own auth token email — prevents tagging a code with someone
        // else's address.
        && (!("claimedEmail" in request.resource.data)
            || request.resource.data.claimedEmail == null
            || request.resource.data.claimedEmail == request.auth.token.email)
        && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["claimedBy", "claimedAt", "claimedEmail"]);
      allow delete: if isAdmin()
        && (!("claimedBy" in resource.data) || resource.data.claimedBy == null);
    }

    match /pageViews/{id} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    match /linkClicks/{id} {
      allow read: if request.auth != null;
      allow create: if true;
    }
  }
}
