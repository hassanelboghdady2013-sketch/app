rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{allPaths=**} {
      allow read: if true;
      // Splitting create/update from delete because `request.resource`
      // is null on delete, so the size/contentType checks below would
      // evaluate to false and silently block the owner from removing
      // their own avatar. Account deletion needs delete; the avatar
      // remove button does too.
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
